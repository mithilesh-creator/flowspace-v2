# Backend — copy to backend/.env

PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Optional in Phase 1. Bypasses RLS — webhooks and admin jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. Must not be "*" in production (the server refuses to
# boot if it is).
CORS_ORIGINS=http://localhost:5173
