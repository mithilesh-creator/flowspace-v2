# Frontend — copy to frontend/.env
#
# Everything VITE_-prefixed is compiled into the JS bundle and served to
# every visitor. The anon key belongs here; the service-role key never
# does, under any variable name.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_API_URL=http://localhost:4000
