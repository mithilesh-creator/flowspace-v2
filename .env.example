# Flowspace v2 — every environment variable the project reads.
# Copy to .env and fill in. Never commit .env.
#
# Keep this file current: per CLAUDE.md, no hardcoded secrets anywhere,
# and this is the single place that documents what a deploy needs.

# ---------------------------------------------------------------------
# Supabase — shared
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to browsers. RLS is what protects the data, not this key.
SUPABASE_ANON_KEY=

# Backend only. Bypasses RLS entirely — never ship this to the frontend,
# never put it in a VITE_-prefixed variable, and use it only for webhooks
# and admin jobs that have no user session to act on behalf of.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations and the RLS test suite.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------
# Backend (Express + Socket.io) — /backend/.env
# ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed for CORS and Socket.io.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Frontend (Vite) — /frontend/.env
# Anything VITE_-prefixed is compiled into the bundle and is public.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------
# Phase 3 — Claude API (not yet used)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
